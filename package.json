{
  "name": "libreleaf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:netlify": "vite build --config vite.netlify.config.ts",
    "libresend:relay": "tsx tools/libresend-relay/server.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:seo && npm run test:guides && npm run test:identity && npm run test:search && npm run test:editions && npm run test:libresend && npm run test:brief && npm run test:lists && npm run test:mcp",
    "test:seo": "node --test tests/netlify-seo.test.mjs",
    "test:guides": "node --import tsx --test tests/guides.test.ts",
    "test:identity": "node --import tsx --test tests/work-identity.test.ts",
    "test:search": "node --import tsx --test tests/search-route.test.ts",
    "test:editions": "node --import tsx --test tests/editions.test.ts",
    "test:libresend": "node --import tsx --test tests/libresend.test.ts",
    "test:brief": "node --import tsx --test tests/brief.test.ts",
    "test:lists": "node --import tsx --test tests/lists.test.ts",
    "test:mcp": "node --import tsx --test tests/mcp.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run lint && npm test && npm run build:netlify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5"
  },
  "type": "module"
}
